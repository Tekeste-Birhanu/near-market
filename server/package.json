{
  "name": "@near-market/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run test/database.integration.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "express": "5.3.0",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
